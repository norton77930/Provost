#!/usr/bin/env bash
# Saving must never block compaction, including launcher failures.
set -uo pipefail
config_file="${PROVOST_CONFIG:-${HOME}/.claude/provost/config.json}"
if [[ ! -e "$config_file" ]]; then
    printf '{}\n'
    exit 0
fi
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if output="$(bash "${script_dir}/runtime" hook)"; then
    printf '%s\n' "$output"
else
    printf '%s\n' '{"terminalSequence":"\u001b]9;Provost handoff runtime unavailable. Compaction continues.\u0007"}'
fi
exit 0
