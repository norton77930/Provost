#!/usr/bin/env bash
# Handoff facts layer hook. Pure bash builtins on every path: no interpreter, no
# external command, no command substitution, no pipe (each process costs about
# 0.5 s on Windows). Never blocks and always exits 0. It never creates the facts
# directory (the runtime side does) and never stores command text, file
# contents, prompts or responses.
# The authoritative gate is the session's enablement marker <session_id>.enabled,
# created by the native SessionStart only when adaptive mode resolves for the
# workspace and handoff is enabled: without it nothing is written or reminded.
# The "handoff": true config match below is only a cheap first check.
# - PostToolUse (async): appends one JSON line per fact to
#   <provost dir>/cache/facts/<session_id>.jsonl, prints {}, and touches the
#   reminder flags <session_id>.pending-edit (main-session edit of a repo file)
#   and <session_id>.pending-dispatch (writer subagent dispatched). A dir fact
#   whose target normalizes to the event's cwd is skipped.
# - UserPromptSubmit (sync): with a pending flag and no <session_id>.reminded,
#   creates .reminded and adds the record reminder once. Independently, every
#   prompt that is a completed <task-notification> (a subagent result) adds a
#   result-record reminder, without reading or touching the flags. Both arrive
#   as one additionalContext; otherwise {}. `record` deletes all three flags.
set -uo pipefail
config_file="${PROVOST_CONFIG:-${HOME}/.claude/provost/config.json}"
config=""
[[ -r "$config_file" ]] && { IFS= read -r -d '' config < "$config_file" || true; }
if ! [[ "$config" =~ \"handoff\"[[:space:]]*:[[:space:]]*true([^A-Za-z0-9_]|$) ]]; then
    printf '{}\n'
    exit 0
fi
facts_dir="${config_file%[/\\]*}/cache/facts"
if [[ ! -d "$facts_dir" ]]; then
    printf '{}\n'
    exit 0
fi
input=""
IFS= read -r -d '' input || true

# Header fields come only from the part before tool_input, tool fields only from
# the part after it, so text inside a tool's own arguments cannot spoof a header.
# A prompt is one JSON string, so its quotes arrive escaped and match no key.
head="$input" body=""
if [[ "$input" == *'"tool_input":'* ]]; then
    head="${input%%\"tool_input\":*}"
    body="${input#*\"tool_input\":}"
    body="${body%%\"tool_response\":*}"
fi

# val_re matches a JSON string value; the capture keeps escapes exactly as sent.
val_re='"(([^"\\]|\\.)*)"'
# get <text> <key>: sets val to the raw first string value of "key", else fails.
get() {
    local re='"'"$2"'"[[:space:]]*:[[:space:]]*'"$val_re"
    if [[ "$1" =~ $re ]]; then
        val="${BASH_REMATCH[1]}"
        return 0
    fi
    val=""
    return 1
}

# norm <raw JSON path>: sets normed to a comparable form: escaped or plain
# backslashes become /, lowercase, no trailing /, and Git Bash /x/... becomes x:/...
norm() {
    local p="${1//\\\\//}"
    p="${p//\\//}"
    p="${p,,}"
    while [[ ${#p} -gt 1 && "$p" == */ ]]; do p="${p%/}"; done
    [[ "$p" =~ ^/([a-z])(/.*)?$ ]] && p="${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"
    normed="$p"
}

val=""
get "$head" hook_event_name
event="$val"
get "$head" session_id
session_id="$val"
if [[ "$event" == UserPromptSubmit && "$session_id" =~ ^[A-Za-z0-9-]+$ ]]; then
    flag="${facts_dir}/${session_id}"
    msg=""
    if [[ -e "${flag}.enabled" ]]; then
        if [[ ( -e "${flag}.pending-edit" || -e "${flag}.pending-dispatch" ) && ! -e "${flag}.reminded" ]]; then
            # Remind only when the marker was written, so a failing write cannot repeat it every turn.
            if : 2>/dev/null > "${flag}.reminded"; then
                msg="Handoff: since the last record this session edited repo files or dispatched a writer subagent. Record the decisions behind them now (status, then record); facts are captured automatically."
            fi
        fi
        # A finished subagent's result arrives as a prompt that starts with
        # <task-notification> (< and > possibly \u-escaped); its first <status> decides.
        # The prompt is read from the whole input: its text may contain "tool_input":.
        lt='(<|\\u003[cC])' gt='(>|\\u003[eE])'
        note_re="^([[:space:]]|\\\\[nrt])*${lt}task-notification${gt}"
        status_re="${lt}status${gt}([A-Za-z_-]*)${lt}"
        if get "$input" prompt && [[ "$val" =~ $note_re ]] && [[ "$val" =~ $status_re ]] \
                && [[ "${BASH_REMATCH[3]}" == completed ]]; then
            if [[ -n "$msg" ]]; then
                msg+=" A subagent result also just arrived: if it changes the work state, record the result milestone too."
            else
                msg="Handoff: a subagent result just arrived. If it changes the work state, record the result milestone now (status, then record); facts are captured automatically."
            fi
        fi
    fi
    if [[ -n "$msg" ]]; then
        printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"'"$msg"'"}}'
    else
        printf '{}\n'
    fi
    exit 0
fi
if [[ "$event" != PostToolUse || -z "$body" ]]; then
    printf '{}\n'
    exit 0
fi
get "$head" tool_name
tool="$val"
get "$head" cwd
cwd="$val"
get "$head" agent_type
agent="$val"
main_session=false
[[ -z "$agent" ]] && ! get "$head" agent_id && main_session=true
if ! [[ "$session_id" =~ ^[A-Za-z0-9-]+$ && -e "${facts_dir}/${session_id}.enabled" ]]; then
    printf '{}\n'
    exit 0
fi
printf -v ts '%(%s)T' -1
prefix="\"v\":1,\"ts\":${ts}"
tail_fields="\"cwd\":\"${cwd}\",\"agent\":\"${agent}\""
out=""
flag=""
writers="${PROVOST_REMINDER_ROLES:-implementer implementer-high implementer-sonnet implementer-deep mech-executor general-purpose}"

case "$tool" in
    Edit|Write|NotebookEdit)
        key=file_path
        [[ "$tool" == NotebookEdit ]] && key=notebook_path
        if get "$body" "$key" && [[ -n "$val" ]]; then
            out="{${prefix},\"k\":\"edit\",${tail_fields},\"tool\":\"${tool}\",\"p\":\"${val}\"}"$'\n'
            # Mirrors facts.OUTSIDE_DEFAULT on the raw JSON text, where an
            # escaped backslash pair is one path separator.
            p="${val//\\\\//}"
            p="${p//\\//}"
            case "${p,,}/" in
                */.claude/jobs/*|*/.claude/projects/*|*/appdata/local/temp/*|*/tmp/*) ;;
                *) [[ "$main_session" == true ]] && flag=pending-edit ;;
            esac
        fi
        ;;
    Agent)
        role="general-purpose"
        if get "$body" subagent_type; then role="$val"; fi
        if [[ "$role" =~ ^[A-Za-z0-9_.:-]+$ ]]; then
            desc=""
            get "$body" description && desc="${val:0:120}"
            # Keep the clipped value valid JSON: drop a dangling backslash, a
            # partial \uXXXX escape or a lone high surrogate from the tail, until
            # none is left (cutting a partial low escape can expose its high one).
            while :; do
                if [[ "$desc" =~ (\\+)$ ]] && (( ${#BASH_REMATCH[1]} % 2 )); then
                    desc="${desc%\\}"
                elif [[ "$desc" =~ (\\+)(u[0-9A-Fa-f]{0,3}|u[dD][89abAB][0-9A-Fa-f]{2})$ ]] \
                        && (( ${#BASH_REMATCH[1]} % 2 )); then
                    desc="${desc%\\u*}"
                else
                    break
                fi
            done
            bg=false
            [[ "$body" =~ \"run_in_background\"[[:space:]]*:[[:space:]]*true([^A-Za-z0-9_]|$) ]] && bg=true
            out="{${prefix},\"k\":\"agent\",${tail_fields},\"role\":\"${role}\",\"desc\":\"${desc}\",\"bg\":${bg}}"$'\n'
            [[ " $writers " == *" $role "* ]] && flag=pending-dispatch
        fi
        ;;
    EnterWorktree|ExitWorktree)
        p=""
        if get "$body" path || get "$body" name; then p="$val"; fi
        out="{${prefix},\"k\":\"worktree\",${tail_fields},\"tool\":\"${tool}\",\"p\":\"${p}\"}"$'\n'
        ;;
    Bash|PowerShell)
        if get "$body" command; then
            cmd="$val"
            # A directory is bare, \"double-quoted\" (escaped in the raw JSON) or
            # 'single-quoted'; bare ends at whitespace, ; & | ) or an escaped quote.
            lead='(^|[^A-Za-z0-9_./-]|\\[nrt])'
            kw='(cd|git[[:space:]]+-C|Set-Location([[:space:]]+-(Path|LiteralPath))?)'
            dq='\\"(([^"\\]|\\[^"])*)\\"'
            sq="'([^']*)'"
            bare='(([^[:space:];&|)\\"'"'"']|\\\\)+)'
            re="${lead}${kw}[[:space:]]+(${dq}|${sq}|${bare})"
            norm "$cwd"
            cwd_norm="$normed"
            count=0
            while (( count < 3 )) && [[ "$cmd" =~ $re ]]; do
                matched="${BASH_REMATCH[0]}"
                d="${BASH_REMATCH[6]}${BASH_REMATCH[8]}${BASH_REMATCH[9]}"
                cmd="${cmd#*"$matched"}"
                if [[ -z "$d" || "$d" == -* || "$d" == *'$('* || "$d" == *'`'* ]]; then
                    continue
                fi
                # The event's cwd already names this directory; relative targets are kept.
                norm "$d"
                [[ "$normed" == "$cwd_norm" ]] && continue
                out+="{${prefix},\"k\":\"dir\",${tail_fields},\"p\":\"${d}\"}"$'\n'
                count=$(( count + 1 ))
            done
        fi
        ;;
esac

if [[ -n "$out" ]]; then
    printf '%s' "$out" 2>/dev/null >> "${facts_dir}/${session_id}.jsonl" || true
fi
if [[ -n "$flag" ]]; then
    : 2>/dev/null > "${facts_dir}/${session_id}.${flag}" || true
fi
printf '{}\n'
exit 0
