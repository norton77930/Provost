#!/usr/bin/env bash
# Personal native entrypoint. Never inject a second orchestration policy.
set -uo pipefail
_src="${BASH_SOURCE[0]//\\//}"
[[ "$_src" == */* ]] || _src="./${_src}"
# Config file: $PROVOST_CONFIG, else <provost dir>/config.json when this script is installed as
# <provost dir>/runtime/<name>/hooks/native-event (read from its own path as written: parameter
# expansion only, no process, links not resolved), else ~/.claude/provost/config.json.
config_file="${PROVOST_CONFIG:-}"
if [[ -z "$config_file" ]]; then
    config_file="${HOME}/.claude/provost/config.json"
    _abs="$_src"
    [[ "$_abs" == /* || "$_abs" == [A-Za-z]:/* ]] || _abs="${PWD}/${_abs}"
    # Collapse . and .. segments lexically (links stay unresolved); a .. above the root
    # leaves _abs empty, which counts as not installed. Parameter expansion only.
    _pre="" _rest="$_abs" _out="" _bad=""
    if [[ "$_rest" == [A-Za-z]:/* ]]; then _pre="${_rest:0:2}"; _rest="${_rest:2}"; fi
    while [[ -n "$_rest" ]]; do
        _seg="${_rest%%/*}"
        case "$_rest" in */*) _rest="${_rest#*/}" ;; *) _rest="" ;; esac
        case "$_seg" in
            "" | .) ;;
            ..)
                if [[ -z "$_out" ]]; then _bad=1; break; fi
                _out="${_out%/*}"
                ;;
            *) _out="${_out}/${_seg}" ;;
        esac
    done
    if [[ -n "$_bad" ]]; then _abs=""; else _abs="${_pre}${_out}"; fi
    _hooks="${_abs%/*}" _name="${_hooks%/*}" _runtime="${_name%/*}" _prov="${_runtime%/*}"
    # The provost directory needs a name of its own: not empty, not a bare drive. (The Git Bash
    # spelling /c of a drive root is not rejected: on Linux /c is an ordinary directory.)
    if [[ "${_hooks##*/}" == hooks && "${_runtime##*/}" == runtime && "$_runtime" == */* \
            && -n "$_prov" && ! "$_prov" =~ ^[A-Za-z]:$ ]]; then
        config_file="${_prov}/config.json"
    fi
fi
if [[ ! -e "$config_file" ]]; then
    printf '{}\n'
    exit 0
fi
# shellcheck source=_python.sh
source "${_src%/*}/_python.sh"
if provost_find_python && output="$("${PROVOST_PY[@]}" -m provost_runtime.cli native-hook)"; then
    printf '%s\n' "$output"
else
    printf '%s\n' '{"systemMessage":"Native handoff runtime unavailable; personal policy unchanged.","terminalSequence":"\u001b]9;Native handoff runtime unavailable. Compaction continues.\u0007"}'
fi
exit 0
