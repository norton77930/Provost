{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start\"",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/handoff-event\"",
            "shell": "bash",
            "async": false,
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/handoff-event\"",
            "shell": "bash",
            "async": false,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
